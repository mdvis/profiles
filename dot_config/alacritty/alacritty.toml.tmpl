[window]
startup_mode = "Maximized"
opacity = 0.85

[font.normal]
family = "SauceCodePro Nerd Font Mono"
style = "Regular"

[font]
size = 16.0

[terminal.shell]
{{- if eq .chezmoi.arch "arm64" }}
program = "/opt/homebrew/bin/tmux"
{{- else }}
program = "/usr/local/bin/tmux"
{{- end }}

[cursor.style]
shape = "Block"
blinking = "Always"

[selection]
save_to_clipboard = true
